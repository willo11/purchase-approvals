{
  "name": "@purchase-approvals/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Serverless backend (Node.js 20 + TypeScript, Clean Architecture) for the purchase approval flow",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "serverless offline",
    "dev:all": "pnpm run db:up && pnpm run dev",
    "test": "jest --coverage",
    "test:unit": "jest --coverage",
    "test:integration": "DYNAMODB_LOCAL=http://localhost:8000 jest --runInBand --coverage=false",
    "pretest": "node scripts/no-focused-tests.mjs",
    "pretest:unit": "node scripts/no-focused-tests.mjs",
    "pretest:integration": "node scripts/no-focused-tests.mjs",
    "predeploy": "node scripts/guard-no-memory-store.mjs",
    "deploy": "pnpm exec sls deploy",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wait": "node --env-file=.env scripts/wait-for-dynamodb.mjs",
    "db:create-table": "node --env-file=.env scripts/create-local-table.mjs",
    "db:seed": "node --env-file=.env scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.8.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
