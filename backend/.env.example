# ─────────────────────────────────────────────────────────────
# backend/.env.example  — TEMPLATE (committed, no real secrets)
# Copy it to `backend/.env` for your local environment:
#   cp backend/.env.example backend/.env
# The variables are loaded with serverless-dotenv-plugin when running
# `serverless offline`. Do NOT put real credentials in this file.
# ─────────────────────────────────────────────────────────────

# ── Local DynamoDB (Docker, dynamodb-local on :8000) ──
# Leave it empty (or remove it) to target real DynamoDB on AWS (deploy).
DYNAMODB_LOCAL=http://localhost:8000

# ── Region. Credentials: Local = dummy (DynamoDB local needs none); Deploy =
#    none here — use the AWS profile (`aws configure`); Lambda provides
#    AWS_REGION automatically at runtime.
# NOTE: do NOT put AWS_REGION in this file. serverless-dotenv-plugin injects
# every .env var into the function environment, and AWS_REGION is a RESERVED
# Lambda environment key — a deploy that sets it fails with
# "environment variables ... contains reserved keys ...: AWS_REGION".
# The code defaults any region reads to us-east-1 (process.env.AWS_REGION ?? 'us-east-1').

# ── Single-table used by the backend ──
# It must exist before testing. See MANUAL-TESTING.md (section "Start local DynamoDB + create the table").
TABLE_NAME=purchase-approvals-dev

# ── Local API port (must match serverless.yml httpPort: 4000) ──
SERVERLESS_PORT=4000

# ── Local evidence store ──
# "memory" → in-memory evidence store: the Download PDF flow works locally
# with NO AWS credentials (the S3 adapter would 404/500 without a bucket).
# Deploy: REMOVE/unset this variable so the deployed Lambdas use S3.
EVIDENCE_STORE=memory

# ── Local approval links ──
# Mock-mail approval links are built by TokenIssuer from APPROVER_BASE_URL.
# Local: the host on :3000 composes the approver remote at /approve, so the
# links open the demo UI directly (no manual host replacement).
# Deploy: set it to the frontend origin (CloudFront URL) BEFORE sls deploy.
APPROVER_BASE_URL=http://localhost:3000
