# ─────────────────────────────────────────────────────────────
# backend/.env.example  — TEMPLATE (commiteado, sin secretos reales)
# Copialo a `backend/.env` para tu entorno local:
#   cp backend/.env.example backend/.env
# Las variables se cargan con serverless-dotenv-plugin al correr
# `serverless offline`. NO pongas credenciales reales en este archivo.
# ─────────────────────────────────────────────────────────────

# ── DynamoDB local (Docker, dynamodb-local en :8000) ──
# Dejalo vacío (o borralo) para apuntar a DynamoDB real en AWS (deploy).
DYNAMODB_LOCAL=http://localhost:8000

# ── Región y credenciales. Local: Dummy. Deploy: las del perfil AWS. ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-dummy
AWS_SECRET_ACCESS_KEY=local-dummy

# ── Tabla single-table que usa el backend ──
# Debe existir antes de probar. Ver MANUAL-TESTING.md (sección "Preparar la tabla").
TABLE_NAME=purchase-approvals-dev

# ── Puerto local del API (debe coincidir con serverless.yml httpPort: 4000) ──
SERVERLESS_PORT=4000